<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/pulse_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/pulse_widget_brand" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/pulse_widget_fg"/>
    <TextView android:id="@+id/widget_configure" android:layout_width="36dp" android:layout_height="match_parent" android:text="⋮" android:textSize="20sp" android:textColor="@color/pulse_widget_muted" android:gravity="center" android:contentDescription="@string/pulse_widget_configure"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"><LinearLayout android:id="@+id/widget_cell_1" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="4dp">
    <TextView android:id="@+id/widget_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pulse_widget_metric_recovery" android:textSize="11sp" android:textColor="@color/pulse_widget_muted" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_value_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:textColor="@color/pulse_widget_fg" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_reason_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/pulse_widget_muted" android:maxLines="1" android:ellipsize="end"/>
    <ProgressBar android:id="@+id/widget_progress_1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#0093e7" android:progressBackgroundTint="#809ba4aa"/>
  </LinearLayout></LinearLayout>
  <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pulse_widget_open" android:textColor="@color/pulse_widget_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
